{
  "name": "prismy",
  "version": "4.0.0-18",
  "description": ":rainbow: Simple and fast type safe server library.",
  "keywords": [
    "http",
    "server",
    "web",
    "type",
    "type-safe",
    "lightweight",
    "fast"
  ],
  "author": "Junyoung Choi <rokt33r.choi@gmail.com>",
  "homepage": "https://github.com/prismyland/prismy",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.d.ts",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismyland/prismy.git"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "lint": "prettier --check src/**/*.ts specs/**/*.ts examples/*/src/**/*.ts",
    "format": "prettier --write src/**/*.ts specs/**/*.ts examples/*/src/**/*.ts",
    "test": "npm run lint && npm run test-type && npm run test-coverage",
    "test-api": "vitest",
    "test-type": "tsc --noEmit",
    "test-coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build",
    "generate-docs": "typedoc src && sh scripts/generate-docs.sh"
  },
  "bugs": {
    "url": "https://github.com/prismyland/prismy/issues"
  },
  "devDependencies": {
    "@types/content-type": "^1.1.3",
    "@types/cookie": "^0.6.0",
    "@types/node": "^18.19.5",
    "@vitest/coverage-v8": "^3.1.1",
    "codecov": "^3.8.0",
    "prettier": "^3.1.1",
    "rimraf": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.2",
    "typescript": "^5.0.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "async-listen": "^3.0.1",
    "content-type": "^1.0.4",
    "cookie": "^1.0.2",
    "is-stream": "^4.0.1",
    "path-to-regexp": "^6.2.0",
    "raw-body": "^2.4.1",
    "tslib": "^2.6.2"
  }
}
